# MongoDB (Atlas connection string or your own server)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=amaya

# Admin login (dashboard at /admin)
ADMIN_EMAIL=admin@veravitaliving.com
ADMIN_PASSWORD=change-this-strong-password

# Secret used to sign the admin session cookie — any long random string
# Generate one with:  openssl rand -base64 32
JWT_SECRET=change-this-to-a-long-random-string

# Chat360 WhatsApp OTP (mobile verification)
CHAT360_API_KEY=your-chat360-api-key
CHAT360_CLIENT_NUMBER=91XXXXXXXXXX
CHAT360_OTP_TEMPLATE=amaya_whatsapp_otp
